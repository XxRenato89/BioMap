# API (apps/api). Cópialo a .env y ajusta.
NODE_ENV=development
PORT=3000
# true: la API sirve los datos de ejemplo sin base de datos (apps/api/seeds/sample-data.js).
USE_MOCKS=false
DATABASE_URL=postgres://biomap:biomap@localhost:5432/biomap
# Solo para los tests de integración; el nombre debe terminar en _test.
TEST_DATABASE_URL=postgres://biomap:biomap@localhost:5432/biomap_test
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=2000
CACHE_TTL_SECONDS=60
MEDIA_DIR=../../media
MEDIA_BASE_URL=/media
LOG_LEVEL=info
# Panel de administración (/admin). Obligatoria en producción: 32+ caracteres al azar,
# por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Días que dura la contraseña del administrador antes de pedir cambiarla.
PASSWORD_MAX_AGE_DAYS=90

# Voz de Quibar (ElevenLabs). La clave queda en el servidor; cada frase se
# genera una vez y se guarda en MEDIA_DIR/tts. Sin clave, se usa la voz del navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=tbfu7H6JPPlpF9clW89V

# Visor (apps/web/.env.local). Todas opcionales.
# VITE_MAP_BOUNDS=-71.855,-37.7672,-71.75374,-37.672  # debe coincidir con apps/web/public/diorama/terrain.json
# VITE_REST_S=45                              # la cámara vuelve sola al inicio
# VITE_IDLE_TIMEOUT_S=120                     # reinicio completo para el próximo visitante
# VITE_IDLE_WARNING_S=10
# VITE_ATTRACT_DELAY_S=60                     # 0 desactiva el modo atracción
# VITE_REFRESH_S=60
# VITE_PUBLIC_URL=http://biomap.local         # URL del código QR del Bio-Book
# VITE_KIOSK_WIFI=BioMap-Angostura
# VITE_QUALITY=medium                         # low | medium | high (calidad 3D del kiosco)
